#!/usr/bin/env bash
printf 'Username Port From Latest\n'
if [[ ${1:-} == -u ]]; then
  case ${2:-} in
    alice) printf 'alice pts/0 198.51.100.10 Thu Jan 2 03:04:05 +0000 2026\n' ;;
    locked) printf 'locked **Never logged in**\n' ;;
    *) printf '%s **Never logged in**\n' "${2:-unknown}" ;;
  esac
else
  printf 'alice pts/0 198.51.100.10 Thu Jan 2 03:04:05 +0000 2026\n'
  printf 'locked **Never logged in**\n'
fi
