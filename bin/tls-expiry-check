#!/usr/bin/env bash
set -uo pipefail
case ${1:-} in
  --help) printf 'Usage: tls-expiry-check [--help|--version]\nReserved for a future read-only implementation.\n'; exit 0 ;;
  --version) printf 'tls-expiry-check 0.1.0\n'; exit 0 ;;
esac
printf 'ERROR: tls-expiry-check is not implemented in version 0.1.0\n' >&2
exit 2
