#!/usr/bin/env bash
set -uo pipefail
case ${1:-} in
  --help) printf 'Usage: disk-capacity-check [--help|--version]\nReserved for a future read-only implementation.\n'; exit 0 ;;
  --version) printf 'disk-capacity-check 0.1.0\n'; exit 0 ;;
esac
printf 'ERROR: disk-capacity-check is not implemented in version 0.1.0\n' >&2
exit 2
