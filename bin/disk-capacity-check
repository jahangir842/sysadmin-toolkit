#!/usr/bin/env bash
set -uo pipefail
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/common.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/logging.sh"
TOOLKIT_TOOL=disk-capacity-check
# shellcheck disable=SC2034
REPORT_TITLE='DISK CAPACITY REPORT'
FORMAT=text
REPORT_FAIL_ON_LEVEL=fail
SPACE_WARN=80 SPACE_FAIL=90 INODE_WARN=80 INODE_FAIL=90 AUDIT_TIMEOUT=20 TOP=10
EXCLUDE_TYPES='proc,sysfs,devtmpfs,devpts,tmpfs,cgroup,cgroup2,securityfs,debugfs,tracefs,pstore,configfs,mqueue,hugetlbfs,fusectl,autofs,binfmt_misc,nsfs,rpc_pipefs'
declare -a EXCLUDE_MOUNTS=() EXPECT_RW=() DISCOVER=()
usage() {
  cat <<'HELP'
Usage: disk-capacity-check [OPTIONS]
Read-only mounted filesystem capacity report (Debian/Ubuntu).
  --format text|json           Output format (default: text)
  --space-warn N --space-fail N Space usage thresholds (default: 80/90 percent)
  --inode-warn N --inode-fail N Inode usage thresholds (default: 80/90 percent)
  --exclude-mount PATH         Exclude an exact mount target; repeatable
  --exclude-types TYPE,...     Replace default virtual filesystem exclusions
  --expect-rw PATH             Require an exact mount target to be writable;
                               repeatable, checked even if otherwise excluded
  --discover PATH             Optional du scan of a directory; repeatable
  --top N                     Largest entries per scan (default: 10)
  --timeout SECONDS           Timeout per query/scan (default: 20)
  --fail-on fail|warn          Exit 1 at this finding threshold
  --help | --version
Discovery uses du -x, depth 1; it scans recursively but never crosses devices.
Exit codes: 0 no policy failures, 1 findings, 2 usage/execution error.
HELP
}
while (($#)); do
  case $1 in
    --help) usage; exit 0 ;;
    --version) printf '%s %s\n' "$TOOLKIT_TOOL" "$TOOLKIT_VERSION"; exit 0 ;;
    --format|--space-warn|--space-fail|--inode-warn|--inode-fail|--exclude-mount|--exclude-types|--expect-rw|--discover|--top|--timeout|--fail-on)
      (($# >= 2)) || die "missing value for $1"
      case $1 in
        --format) FORMAT=$2 ;; --space-warn) SPACE_WARN=$2 ;; --space-fail) SPACE_FAIL=$2 ;;
        --inode-warn) INODE_WARN=$2 ;; --inode-fail) INODE_FAIL=$2 ;;
        --exclude-mount) EXCLUDE_MOUNTS+=("$2") ;; --exclude-types) EXCLUDE_TYPES=$2 ;;
        --expect-rw) EXPECT_RW+=("$2") ;; --discover) DISCOVER+=("$2") ;;
        --top) TOP=$2 ;; --timeout) AUDIT_TIMEOUT=$2 ;; --fail-on) REPORT_FAIL_ON_LEVEL=$2 ;;
      esac
      shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done
[[ $FORMAT == text || $FORMAT == json ]] || die 'format must be text or json'
[[ $REPORT_FAIL_ON_LEVEL == fail || $REPORT_FAIL_ON_LEVEL == warn ]] || die 'fail-on must be fail or warn'
for number in "$SPACE_WARN" "$SPACE_FAIL" "$INODE_WARN" "$INODE_FAIL"; do
  [[ $number =~ ^([1-9][0-9]?|100)$ ]] || die 'thresholds must be integers from 1 to 100'
done
((SPACE_WARN < SPACE_FAIL && INODE_WARN < INODE_FAIL)) || die 'warning thresholds must be below failure thresholds'
[[ $TOP =~ ^[1-9][0-9]*$ && ${#TOP} -le 4 ]] || die 'top must be between 1 and 9999'
[[ $AUDIT_TIMEOUT =~ ^[1-9][0-9]*$ && ${#AUDIT_TIMEOUT} -le 5 ]] || die 'timeout must be between 1 and 99999 seconds'
for path in "${EXCLUDE_MOUNTS[@]}" "${EXPECT_RW[@]}" "${DISCOVER[@]}"; do
  [[ $path == /* ]] || die 'mount and discovery paths must be absolute'
done
for dependency in findmnt df jq timeout; do require_command "$dependency"; done
if ((${#DISCOVER[@]})); then require_command du; fi
export LC_ALL=C
make_temp_dir
query() { timeout --kill-after=2 "$AUDIT_TIMEOUT" "$@"; }
query findmnt --json --list --output TARGET,SOURCE,FSTYPE,OPTIONS >"$TOOLKIT_TMPDIR/mounts" 2>/dev/null || die 'cannot inventory mounts'
jq -e '.filesystems | type == "array" and all(.[]; (.target | type == "string") and (.fstype | type == "string") and (.options | type == "string"))' "$TOOLKIT_TMPDIR/mounts" >/dev/null || die 'invalid mount inventory'
contains_path() {
  local wanted=$1 item; shift
  for item in "$@"; do [[ $item != "$wanted" ]] || return 0; done
  return 1
}
metric() {
  local target=$1 kind=$2 fields=$3 warn=$4 fail=$5 values total used available percent extra level details
  details=$(jq -cn --arg mount "$target" '{mount:$mount}')
  if ! values=$(query df -B1 --output="$fields" -- "$target" 2>/dev/null); then
    add_finding UNKNOWN "$kind" "$target: capacity query failed or timed out" "$details"; return
  fi
  values=${values#*$'\n'}
  read -r total used available percent extra <<<"$values"
  percent=${percent%\%}
  if [[ ! $total =~ ^[0-9]+$ || ! $used =~ ^[0-9]+$ || ! $available =~ ^[0-9]+$ || ! $percent =~ ^[0-9]+$ || -n $extra || $total == 0 ]]; then
    add_finding UNKNOWN "$kind" "$target: capacity unavailable or unsupported" "$details"; return
  fi
  # df reports ceiling percentages and may exceed 100% on reserved-block filesystems.
  level=PASS
  ((10#$percent >= warn)) && level=WARN
  ((10#$percent >= fail)) && level=FAIL
  details=$(jq -cn --arg mount "$target" --argjson total "$total" --argjson used "$used" --argjson available "$available" --argjson percent "$percent" --argjson warn "$warn" --argjson fail "$fail" '{mount:$mount,total:$total,used:$used,available:$available,percent:$percent,warn_threshold:$warn,fail_threshold:$fail}')
  add_finding "$level" "$kind" "$target: usage=$percent% total=$total used=$used available=$available" "$details"
}
checked=0
while IFS= read -r mount; do
  target=$(jq -r '.target' <<<"$mount")
  type=$(jq -r '.fstype' <<<"$mount")
  options=$(jq -r '.options' <<<"$mount")
  details=$(jq -c '{mount:.target,source:.source,fstype:.fstype,options:.options}' <<<"$mount")
  if contains_path "$target" "${EXPECT_RW[@]}"; then
    if [[ ,$options, == *,ro,* ]]; then
      add_finding FAIL disk-mount "$target: read-only but expected writable" "$details"
    elif [[ ,$options, == *,rw,* ]]; then
      add_finding PASS disk-mount "$target: writable as expected" "$details"
    else add_finding UNKNOWN disk-mount "$target: writable state unavailable" "$details"; fi
  fi
  contains_path "$target" "${EXCLUDE_MOUNTS[@]}" && continue
  [[ ,$EXCLUDE_TYPES, != *",$type,"* ]] || continue
  ((checked += 1))
  add_finding INFO disk-mount "$target: type=$type options=$options" "$details"
  metric "$target" disk-space size,used,avail,pcent "$SPACE_WARN" "$SPACE_FAIL"
  metric "$target" disk-inodes itotal,iused,iavail,ipcent "$INODE_WARN" "$INODE_FAIL"
done < <(jq -c '.filesystems[]' "$TOOLKIT_TMPDIR/mounts")
for path in "${EXPECT_RW[@]}"; do
  if ! jq -e --arg path "$path" 'any(.filesystems[]; .target == $path)' "$TOOLKIT_TMPDIR/mounts" >/dev/null; then
    add_finding FAIL disk-mount "$path: expected writable mount is missing"
  fi
done
((checked > 0)) || add_finding INFO disk-space 'no filesystems selected after exclusions'
for path in "${DISCOVER[@]}"; do
  if [[ ! -d $path ]]; then add_finding UNKNOWN disk-discovery "$path: directory unavailable"; continue; fi
  if ! query du -x -B1 --max-depth=1 --null -- "$path" >"$TOOLKIT_TMPDIR/du" 2>/dev/null; then
    add_finding UNKNOWN disk-discovery "$path: discovery failed, timed out, or incomplete; partial results omitted"
    continue
  fi
  printf '[]\n' >"$TOOLKIT_TMPDIR/entries"
  valid=yes
  while IFS= read -r -d '' entry; do
    size=${entry%%$'\t'*}; directory=${entry#*$'\t'}
    if [[ ! $size =~ ^[0-9]+$ || $entry != *$'\t'* ]]; then valid=no; break; fi
    jq -cn --arg path "$directory" --argjson bytes "$size" '{path:$path,bytes:$bytes}' >>"$TOOLKIT_TMPDIR/entries"
  done <"$TOOLKIT_TMPDIR/du"
  if [[ $valid != yes ]]; then add_finding UNKNOWN disk-discovery "$path: invalid discovery output"; continue; fi
  details=$(jq -s --argjson top "$TOP" 'flatten | sort_by(.bytes) | reverse | .[:$top]' "$TOOLKIT_TMPDIR/entries")
  message=$(jq -r 'map("\(.path): \(.bytes) bytes") | join("; ")' <<<"$details")
  add_finding INFO disk-discovery "$path: allocated sizes (includes scan root): $message" "$details"
done
add_finding INFO host "hostname=$(hostname 2>/dev/null || printf unknown) timestamp=$(date -u +%FT%TZ) os=Linux kernel=$(uname -r) uptime=$(uptime -p 2>/dev/null || printf unknown)"
if [[ $FORMAT == json ]]; then render_json; else render_text; fi
findings_exit_code
